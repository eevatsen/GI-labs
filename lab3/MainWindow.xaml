<Window x:Class="lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Записна книжка" Height="450" Width="400">

    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE1E1E1" Offset="0"/>
            <GradientStop Color="#FFB5D0FF" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="AddNote_Executed" CanExecute="AddNote_CanExecute"/>
        <CommandBinding Command="Delete" Executed="Clear_Executed" CanExecute="Clear_CanExecute"/>
    </Window.CommandBindings>

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Новий запис" Grid.Row="0" Margin="10">
            <StackPanel Margin="5">
                <TextBox x:Name="txtNoteEntry" Height="80" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <Button Command="New" Content="Зафіксувати в журналі" HorizontalAlignment="Right"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Журнал записів" Grid.Row="1" Margin="10">
            <ListBox x:Name="lbJournal" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}" Padding="5">
            <DockPanel>
                <Button Command="Delete" Content="Очистити журнал" DockPanel.Dock="Right"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0" Text="Кількість записів: "/>
                <TextBlock VerticalAlignment="Center" Text="{Binding Items.Count, ElementName=lbJournal}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>